# Signs admin sessions and encrypts API keys. Any long random string works:
#   openssl rand -hex 32
PAYLOAD_SECRET=

# Postgres connection string. Hosted providers (Neon, Supabase…) need
# `?sslmode=require` on the end.
DATABASE_URI=postgresql://postgres:postgres@localhost:5432/noiz

# Admin account created by `pnpm seed` when no user exists yet.
PAYLOAD_SEED_USER_EMAIL=admin@noiz.systems
PAYLOAD_SEED_USER_PASSWORD=changeme

# --- Help center (/support) ------------------------------------------------
# Tickets live in BDMarket's Firebase project; the email must belong to a
# BDMarket account and is confirmed with a code before a ticket is created.
FIREBASE_PROJECT_ID=bdmarket-63c35
# Service-account JSON of that project, raw or base64. Locally you can point
# GOOGLE_APPLICATION_CREDENTIALS at the JSON file instead.
FIREBASE_SERVICE_ACCOUNT=
# Local development against the Firebase emulators (leave unset otherwise):
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8085
# FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099

# Resend, same account as BDMarket's Cloud Functions. Without a key, in
# development the emails (codes included) are printed to the server console.
RESEND_API_KEY=
RESEND_FROM_EMAIL=BDMarket <support@noizsystems.tech>

# Signs the verified-email cookie. Defaults to PAYLOAD_SECRET when empty.
SUPPORT_SECRET=
